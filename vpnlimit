#!/bin/bash
# vpnlimit — ограничение скорости на каждый IP клиента для портов Xray
#
#   vpnlimit                       — интерактивное меню
#   vpnlimit on | off | status     — включить / выключить / состояние
#   vpnlimit <Мбит>                — задать скорость в обе стороны и включить
#   vpnlimit wl                    — показать белый список
#   vpnlimit wl add <IP> [комм.]   — добавить IP или подсеть в белый список
#   vpnlimit wl del <IP>           — убрать из белого списка
#
# Работает только со своей таблицей "inet vpnlimit".
# /etc/nftables.conf, службу nftables, ufw и правила Docker не трогает.

TABLE="inet vpnlimit"
CONF_DIR="/etc/vpnlimit"
CONF="$CONF_DIR/vpnlimit.conf"
WL="$CONF_DIR/whitelist.txt"
UNIT="/etc/systemd/system/vpnlimit.service"
SELF=$(readlink -f "$0")
SSH_IP=${SSH_CLIENT%% *}

[ "$(id -u)" -eq 0 ] || { echo "Запускайте от root"; exit 1; }
NFT=$(command -v nft) || { echo "nft не найден: apt install nftables"; exit 1; }

if [ -t 1 ]; then
  G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; C=$'\e[36m'; B=$'\e[1m'; D=$'\e[2m'; N=$'\e[0m'
else
  G=; R=; Y=; C=; B=; D=; N=
fi

# ---------- настройки ----------
load_conf() {
  DL=7; UL=7; PORTS="443"
  [ -f "$CONF" ] && . "$CONF"
}
save_conf() {
  mkdir -p "$CONF_DIR"
  printf 'DL=%s\nUL=%s\nPORTS="%s"\n' "$DL" "$UL" "$PORTS" > "$CONF"
}
fmt_rate() { if (( $1 == 0 )); then echo "без ограничения"; else echo "$1 Мбит/с на IP"; fi; }

# ---------- белый список ----------
wl_ips()   { awk '/^[ \t]*(#|$)/{next} {print $1}' "$WL" 2>/dev/null; }
wl_count() { wl_ips | grep -c .; }

wl_show() {
  if (( $(wl_count) == 0 )); then echo "  (пусто)"; return; fi
  awk '/^[ \t]*(#|$)/{next} {i++; printf "  %2d) %s\n", i, $0}' "$WL"
}

wl_add() {
  local ip=${1,,} cm=$2 fam
  if ! [[ "$ip" =~ ^[0-9a-f.:/]+$ ]]; then echo "${R}Неверный адрес: $1${N}"; return 1; fi
  if wl_ips | grep -qxF "$ip"; then echo "${Y}$ip уже в белом списке.${N}"; return 1; fi
  if [[ "$ip" == *:* ]]; then fam=ipv6_addr; else fam=ipv4_addr; fi
  # проверяем адрес самим nft (режим -c ничего не применяет)
  if ! printf 'table inet vpnlimit_check { set t { type %s; flags interval; elements = { %s } } }\n' \
         "$fam" "$ip" | "$NFT" -c -f - >/dev/null 2>&1; then
    echo "${R}Неверный адрес: $ip${N}"; return 1
  fi
  mkdir -p "$CONF_DIR"
  if [ -n "$cm" ]; then printf '%s  # %s\n' "$ip" "$cm" >> "$WL"; else echo "$ip" >> "$WL"; fi
  echo "${G}Добавлен в белый список: $ip${N}"
}

wl_del_ip() {
  local ip=${1,,}
  if ! wl_ips | grep -qxF "$ip"; then echo "${Y}$ip нет в белом списке.${N}"; return 1; fi
  awk -v ip="$ip" '$1 != ip' "$WL" > "$WL.tmp" && mv "$WL.tmp" "$WL"
  echo "${G}Удалён из белого списка: $ip${N}"
}

wl_del_num() {
  local n total
  total=$(wl_count)
  (( total )) || { echo "Список пуст."; return 1; }
  wl_show; echo
  read -rp "Номер для удаления (Enter — отмена): " n
  [ -z "$n" ] && { echo "Отменено."; return 1; }
  if ! [[ "$n" =~ ^[0-9]+$ ]] || (( 10#$n < 1 || 10#$n > total )); then
    echo "${R}Нет такого номера.${N}"; return 1
  fi
  wl_del_ip "$(wl_ips | sed -n "$((10#$n))p")"
}

wl_pick_active() {
  is_on || { echo "Лимит выключен — активных клиентов не видно."; return 1; }
  local ips n cm i
  mapfile -t ips < <(client_ips)
  (( ${#ips[@]} )) || { echo "Сейчас нет активных клиентов."; return 1; }
  echo "Активные клиенты:"
  for i in "${!ips[@]}"; do printf '  %2d) %s\n' $((i+1)) "${ips[$i]}"; done
  echo
  read -rp "Номер (Enter — отмена): " n
  [ -z "$n" ] && { echo "Отменено."; return 1; }
  if ! [[ "$n" =~ ^[0-9]+$ ]] || (( 10#$n < 1 || 10#$n > ${#ips[@]} )); then
    echo "${R}Нет такого номера.${N}"; return 1
  fi
  read -rp "Комментарий (необязательно): " cm
  wl_add "${ips[$((10#$n - 1))]}" "$cm"
}

wl_menu() {
  local c ip cm
  while true; do
    clear
    echo "${B}Белый список${N} ${D}(эти адреса не ограничиваются)${N}"
    echo
    wl_show
    echo
    echo "  ${C}1${N}) Добавить IP или подсеть"
    [ -n "$SSH_IP" ] && echo "  ${C}2${N}) Добавить мой текущий IP ($SSH_IP)"
    echo "  ${C}3${N}) Выбрать из активных клиентов"
    echo "  ${C}4${N}) Удалить из списка"
    echo "  ${C}0${N}) Назад"
    echo
    read -rp "Выберите пункт: " c
    echo
    case "$c" in
      1) read -rp "IP или подсеть (например 1.2.3.4 или 10.0.0.0/24, Enter — отмена): " ip
         if [ -n "$ip" ]; then
           read -rp "Комментарий (необязательно): " cm
           wl_add "$ip" "$cm" && reapply
         else echo "Отменено."; fi
         pause ;;
      2) if [ -n "$SSH_IP" ]; then wl_add "$SSH_IP" "мой IP (SSH)" && reapply; pause; fi ;;
      3) wl_pick_active && reapply; pause ;;
      4) wl_del_num && reapply; pause ;;
      0|q|Q) return ;;
    esac
  done
}

# ---------- правила nftables ----------
is_on()   { "$NFT" list table $TABLE >/dev/null 2>&1; }
is_auto() { systemctl is-enabled vpnlimit >/dev/null 2>&1; }

gen_rules() {
  local dl=$(( DL * 125000 )) ul=$(( UL * 125000 )) s wl4 wl6
  wl4=$(wl_ips | grep -v ':' | paste -sd, -)
  wl6=$(wl_ips | grep ':'    | paste -sd, -)

  echo "table $TABLE"
  echo "delete table $TABLE"
  echo "table $TABLE {"
  for s in dl4 ul4; do echo "  set $s { type ipv4_addr; size 65535; flags dynamic,timeout; timeout 2m; }"; done
  for s in dl6 ul6; do echo "  set $s { type ipv6_addr; size 65535; flags dynamic,timeout; timeout 2m; }"; done

  echo "  set allow4 {"
  echo "    type ipv4_addr; flags interval; auto-merge;"
  [ -n "$wl4" ] && echo "    elements = { $wl4 }"
  echo "  }"
  echo "  set allow6 {"
  echo "    type ipv6_addr; flags interval; auto-merge;"
  [ -n "$wl6" ] && echo "    elements = { $wl6 }"
  echo "  }"

  if (( DL > 0 )); then
    cat <<EOF
  chain out {
    type filter hook output priority filter; policy accept;
    ip  daddr @allow4 accept
    ip6 daddr @allow6 accept
    meta l4proto { tcp, udp } th sport { $PORTS } update @dl4 { ip daddr  limit rate over $dl bytes/second burst 524288 bytes } drop
    meta l4proto { tcp, udp } th sport { $PORTS } update @dl6 { ip6 daddr limit rate over $dl bytes/second burst 524288 bytes } drop
  }
EOF
  fi
  if (( UL > 0 )); then
    cat <<EOF
  chain in {
    type filter hook input priority filter; policy accept;
    ip  saddr @allow4 accept
    ip6 saddr @allow6 accept
    meta l4proto { tcp, udp } th dport { $PORTS } update @ul4 { ip saddr  limit rate over $ul bytes/second burst 524288 bytes } drop
    meta l4proto { tcp, udp } th dport { $PORTS } update @ul6 { ip6 saddr limit rate over $ul bytes/second burst 524288 bytes } drop
  }
EOF
  fi
  echo "}"
}

rules_on() {
  if (( DL == 0 && UL == 0 )); then
    echo "${Y}Оба лимита равны 0 — ограничивать нечего.${N}"; return 1
  fi
  local tmp err
  tmp=$(mktemp)
  gen_rules > "$tmp"
  # сначала проверка, потом атомарное применение: при ошибке ничего не меняется
  if err=$( { "$NFT" -c -f "$tmp" && "$NFT" -f "$tmp"; } 2>&1 ); then
    rm -f "$tmp"; return 0
  fi
  rm -f "$tmp"
  echo "${R}Ошибка, правила не применены:${N}"; echo "$err"; return 1
}

rules_off() { "$NFT" delete table $TABLE 2>/dev/null; return 0; }

reapply() {
  if ! is_on; then
    echo "Сохранено. Лимит сейчас выключен."; return
  fi
  if (( DL == 0 && UL == 0 )); then
    rules_off; echo "${Y}Оба лимита равны 0 — лимит выключен.${N}"; return
  fi
  rules_on && echo "${G}Сохранено и применено.${N}"
}

# ---------- автозагрузка (своя служба, не nftables.service) ----------
auto_on() {
  save_conf
  cat > "$UNIT" <<EOF
[Unit]
Description=VPN per-IP rate limit (vpnlimit)
After=network-online.target

[Service]
Type=oneshot
ExecStart=$SELF on

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable vpnlimit >/dev/null 2>&1
}
auto_off() {
  systemctl disable vpnlimit >/dev/null 2>&1
  rm -f "$UNIT"
  systemctl daemon-reload
}

# ---------- клиенты ----------
client_ips() {
  { for s in dl4 dl6 ul4 ul6; do "$NFT" list set $TABLE $s 2>/dev/null; done; } \
    | sed -n '/elements/,/}/p' \
    | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}|[0-9a-f]*:[0-9a-f:]+' | sort -u
}

clients_live() {
  local ips
  while true; do
    clear
    echo "${B}Клиенты под лимитом${N} ${D}(активность за последние ~2 минуты, обновление каждые 2 с)${N}"
    echo "${D}Адреса из белого списка здесь не показываются.${N}"
    echo
    if ! is_on; then
      echo "  Лимит выключен."
    else
      ips=$(client_ips)
      if [ -n "$ips" ]; then
        echo "$ips" | sed 's/^/  /'
        echo; echo "  Всего: $(echo "$ips" | wc -l)"
      else
        echo "  (пока никого)"
      fi
    fi
    echo; echo "${D}Нажмите любую клавишу, чтобы вернуться...${N}"
    read -rsn1 -t 2 && break
  done
}

# ---------- ввод ----------
pause() { echo; read -rsp "Нажмите Enter, чтобы вернуться в меню..." _; echo; }

ask_rate() {
  local v
  read -rp "$1, Мбит/с (0 — без ограничения, Enter — отмена): " v
  [ -z "$v" ] && { echo "Отменено."; return 1; }
  if [[ "$v" =~ ^[0-9]+$ ]] && (( 10#$v <= 10000 )); then
    REPLY_RATE=$((10#$v)); return 0
  fi
  echo "${R}Нужно целое число от 0 до 10000.${N}"; return 1
}

edit_ports() {
  echo "Сейчас на сервере слушают:"
  ss -Hlntup 2>/dev/null | awk '{ p=""; if (match($0,/\(\("[^"]+"/)) p=substr($0,RSTART+3,RLENGTH-4);
                                  printf "  %-4s %-24s %s\n", $1, $5, p }' | sort -u
  echo
  local v p a list=()
  read -rp "Порты через запятую (сейчас: $PORTS, Enter — отмена): " v
  [ -z "$v" ] && { echo "Отменено."; return; }
  for p in ${v//,/ }; do
    if ! [[ "$p" =~ ^[0-9]+$ ]] || (( 10#$p < 1 || 10#$p > 65535 )); then
      echo "${R}Неверный порт: $p${N}"; return
    fi
    list+=("$((10#$p))")
  done
  for p in "${list[@]}"; do
    if ss -Hlntp "sport = :$p" 2>/dev/null | grep -q '"sshd"'; then
      read -rp "${Y}Порт $p — это SSH. Точно ограничивать его? [y/N]: ${N}" a
      [[ "$a" =~ ^[yYдД]$ ]] || { echo "Отменено."; return; }
    fi
  done
  PORTS=$(printf '%s\n' "${list[@]}" | sort -nu | paste -sd, - | sed 's/,/, /g')
  save_conf
  reapply
}

reset_all() {
  local a
  read -rp "Удалить лимит, автозагрузку, настройки и белый список? [y/N]: " a
  [[ "$a" =~ ^[yYдД]$ ]] || { echo "Отменено."; return; }
  rules_off; auto_off; rm -rf "$CONF_DIR"
  echo "${G}Всё удалено.${N} Сам скрипт можно удалить командой: rm $SELF"
}

# ---------- экран ----------
header() {
  local st au cnt
  if is_on; then st="${G}● ВКЛЮЧЁН${N}"; cnt=$(client_ips | grep -c .); else st="${R}○ выключен${N}"; cnt="—"; fi
  if is_auto; then au="${G}да${N}"; else au="${D}нет${N}"; fi
  echo "${B}═══ vpnlimit — лимит скорости на клиента ═══${N}"
  echo "  Состояние:     $st"
  echo "  Скачивание:    $(fmt_rate "$DL")"
  echo "  Загрузка:      $(fmt_rate "$UL")"
  echo "  Порты:         $PORTS"
  echo "  Белый список:  $(wl_count) адр."
  echo "  Автозагрузка:  $au"
  echo "  Клиентов:      $cnt"
}

menu() {
  local c
  while true; do
    load_conf
    clear
    header
    echo
    if is_on; then echo "  ${C}1${N}) Выключить лимит"; else echo "  ${C}1${N}) Включить лимит"; fi
    echo "  ${C}2${N}) Изменить скорость скачивания"
    echo "  ${C}3${N}) Изменить скорость загрузки"
    echo "  ${C}4${N}) Изменить порты"
    if is_auto; then echo "  ${C}5${N}) Отключить автозагрузку"
    else echo "  ${C}5${N}) Включить автозагрузку (лимит сохранится после перезагрузки)"; fi
    echo "  ${C}6${N}) Клиенты под лимитом"
    echo "  ${C}7${N}) Белый список ($(wl_count))"
    echo "  ${C}9${N}) Удалить всё (сброс)"
    echo "  ${C}0${N}) Выход"
    echo
    read -rp "Выберите пункт: " c
    echo
    case "$c" in
      1) if is_on; then
           rules_off; echo "${Y}Лимит выключен.${N}"
           is_auto && echo "Автозагрузка включена — после перезагрузки лимит включится снова."
         else
           rules_on && echo "${G}Лимит включён.${N}"
         fi; pause ;;
      2) if ask_rate "Скорость скачивания"; then DL=$REPLY_RATE; save_conf; reapply; fi; pause ;;
      3) if ask_rate "Скорость загрузки";   then UL=$REPLY_RATE; save_conf; reapply; fi; pause ;;
      4) edit_ports; pause ;;
      5) if is_auto; then
           auto_off; echo "Автозагрузка отключена. После перезагрузки лимита не будет."
         else
           auto_on; echo "${G}Автозагрузка включена.${N} После перезагрузки лимит включится с текущими настройками."
         fi; pause ;;
      6) clients_live ;;
      7) wl_menu ;;
      9) reset_all; pause ;;
      0|q|Q) clear; exit 0 ;;
    esac
  done
}

usage() {
  cat <<EOF
Использование:
  vpnlimit                       меню
  vpnlimit on | off | status     включить / выключить / состояние
  vpnlimit <Мбит>                скорость в обе стороны и включить
  vpnlimit wl                    показать белый список
  vpnlimit wl add <IP> [комм.]   добавить IP или подсеть
  vpnlimit wl del <IP>           удалить из белого списка
EOF
}

# ---------- запуск ----------
load_conf
case "$1" in
  ""|menu) menu ;;
  on)      rules_on || exit 1
           echo "Лимит включён: скачивание $(fmt_rate "$DL"), загрузка $(fmt_rate "$UL"), порты $PORTS, белый список: $(wl_count)" ;;
  off)     rules_off; echo "Лимит выключен" ;;
  status)  header ;;
  wl|whitelist)
    case "$2" in
      ""|list) wl_show ;;
      add)     [ -n "$3" ] || { usage; exit 1; }
               wl_add "$3" "${*:4}" && reapply ;;
      del|rm)  [ -n "$3" ] || { usage; exit 1; }
               wl_del_ip "$3" && reapply ;;
      *)       usage; exit 1 ;;
    esac ;;
  -h|--help) usage ;;
  *)       if [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 10000 )); then
             DL=$((10#$1)); UL=$DL; save_conf
             rules_on && echo "Лимит включён: $DL Мбит/с на IP, порты $PORTS"
           else
             usage; exit 1
           fi ;;
esac